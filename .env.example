APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Основной домен (web + админка MoonShine) и домен API. Без порта и схемы.
# Дефолты в config/app.php: example.com / api.example.com.
APP_DOMAIN=localhost
APP_API_DOMAIN=api.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

TELEGRAM_TOKEN=
# Секрет вебхука (заголовок X-Telegram-Bot-Api-Secret-Token).
# Пусто -> используется md5(APP_KEY), как в nutgram:hook:set.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOG_CHANNEL=single
# Username бота без @. На сообщения с его упоминанием бот отвечает через LLM.
# Пусто — упоминания игнорируются.
TELEGRAM_BOT_USERNAME=my_cool_bot
# Секунды на ответ LLM (меньше таймаута задачи AnswerBotMentionJob — 80 c).
TELEGRAM_MENTION_LLM_TIMEOUT=60

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=admin
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Внутри docker-сети обращаемся по имени сервиса.
# Если artisan/php запускается с хоста, поставь 127.0.0.1 (порт 6379 проброшен).
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

REDIS_DB=0
REDIS_CACHE_DB=1
# Отдельная база под очереди (подключение queue в config/database.php).
REDIS_QUEUE_DB=2
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=true
SENTRY_TRACES_SAMPLE_RATE=1.0

# llama.cpp (сервис llama). GGUF-модели кладём в dockerConfigs/models,
# их настройки — в dockerConfigs/llama/models.ini.
# Внутри docker-сети: http://llama:8080
LLAMA_PORT=8080
# Сколько моделей держать загруженными одновременно.
LLAMA_MODELS_MAX=1
# laravel/ai ходит в llama.cpp как в OpenAI-совместимый API (config/ai.php).
LLAMA_URL=http://llama:8080/v1
# Имя GGUF-файла из dockerConfigs/models без .gguf.
LLAMA_MODEL=FineQwen3.5-2B_Q4
